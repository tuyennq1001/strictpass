{
  "manifest_version": 3,
  "name": "StrictPass — Password Generator",
  "version": "1.0.0",
  "author": "Terry Nguyen",
  "homepage_url": "https://tuyennq1001.github.io/strictpass/",
  "description": "StrictPass: Minimalist CSPRNG password generator that strictly guarantees every selected character group is included.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "StrictPass",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}
